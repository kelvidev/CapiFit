{
  // A depuracao Android usa a extensao "adelphes.android-dev-ext" (ja instalada).
  // Antes do F5, suba o emulador: task "fitvara: subir emulador".
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Fitvara: debug no emulador",
      "type": "android",
      "request": "launch",
      "appSrcRoot": "${workspaceFolder}/app/src/main",
      "apkFile": "${workspaceFolder}/app/build/outputs/apk/debug/app-debug.apk",
      "launchActivity": "com.fitvara.app.MainActivity",
      "adbPort": 5037,
      "autoStartADB": true,
      "targetDevice": "emulator-5554",
      "preLaunchTask": "fitvara: build debug"
    },
    {
      "name": "Fitvara: anexar ao app em execucao",
      "type": "android",
      "request": "attach",
      "appSrcRoot": "${workspaceFolder}/app/src/main",
      "processId": "${command:PickAndroidProcess}",
      "adbPort": 5037
    }
  ]
}
